<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/localTab"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerInParent="true"
        android:text="@string/arcore_notice_title"
        style="@style/TitleText" />

    <!-- Fills the page, so the buttons stand in the middle of the room under the text, and
         scrolls on small screens. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/titleText"
        android:layout_above="@+id/buttonNext"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dip"
                android:adjustViewBounds="true"
                android:src="@drawable/ic_arcore" />

            <TextView
                android:id="@+id/fragmentText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/DescriptionText" />

            <include
                android:id="@+id/arCoreInstall"
                layout="@layout/arcore_install_badges"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="10dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/buttonNext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"
        style="?android:imageButtonStyle"
        android:background="?android:selectableItemBackground"
        android:padding="5dp"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:onClick="onClick"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textSettings"
            style="@style/ToolsText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="1dp"
            android:textStyle="bold"
            android:text="@string/next" />

        <ImageView
            android:id="@+id/viewSettingsIcon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:cropToPadding="true"
            android:scaleType="fitXY"
            android:adjustViewBounds="true"
            android:src="@drawable/ic_next" />
    </LinearLayout>

</RelativeLayout>
