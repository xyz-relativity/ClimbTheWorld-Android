<?xml version="1.0" encoding="utf-8"?>
<!-- The outline of a route aligned on in the A.R. align dialog, around its card, its distance
     and its delete button, in the green the align button's info icon turns once a route is
     aligned on, see ArCoreSession. No padding of its own: the route's layout keeps the same
     padding outlined or not, so the strip does not shift. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <corners android:radius="6dp" />
    <stroke
        android:width="2dp"
        android:color="@android:color/holo_green_light" />
</shape>
