<?xml version="1.0" encoding="utf-8"?>
<!-- The pill of the A.R. align dialog's buttons saying how many more suggested routes are out of
     sight on a side of the strip, see AlignmentPicker: outlined in the accent colour, as the
     suggested routes are, see bg_align_route_suggested, and filled, as it floats over the
     routes. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?android:colorBackground" />
            <corners android:radius="16dp" />
            <stroke
                android:width="2dp"
                android:color="?android:colorAccent" />
        </shape>
    </item>
</ripple>
