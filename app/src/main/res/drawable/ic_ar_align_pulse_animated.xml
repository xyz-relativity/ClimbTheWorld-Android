<?xml version="1.0" encoding="utf-8"?>
<!-- The ring of ic_ar_align_pulse growing and fading out, over and over, like the wave of
     ic_info_animated on the info icon when no map is downloaded. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_ar_align_pulse">
    <target
        android:name="wave"
        android:animation="@animator/pulse_grow" />
    <target
        android:name="ring"
        android:animation="@animator/pulse_fade" />
</animated-vector>
