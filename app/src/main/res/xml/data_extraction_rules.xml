<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 12 and later; backup_rules.xml has them for older versions.
   See https://developer.android.com/identity/data/autobackup
-->
<data-extraction-rules>
    <!-- Only the personal log book: it is all that cannot be downloaded again. The OSM cache is
         too big for the backup quota, and the settings hold the OSM login token. -->
    <cloud-backup>
        <include
            domain="database"
            path="personalLogBook.db" />
    </cloud-backup>
    <!-- No device-transfer rules: moving to a new phone with a cable or Wi-Fi copies all the
         app's data, as before. -->
</data-extraction-rules>
