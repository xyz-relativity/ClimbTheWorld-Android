<resources>

    <style name="BaseActivityTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="floatingActionButtonStyle">@style/NoShadowFloatingActionButton</item>
    </style>

    <style name="ActivityTheme" parent="BaseActivityTheme" />

    <style name="ToolsText">
        <item name="android:textAlignment">textStart</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="MainText">
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ItemSectionTitles" parent="TextAppearance.AppCompat.Widget.Button.Borderless.Colored">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">2dp</item>
    </style>

    <!-- Header of an entry, in the editors and the info dialogs alike, so they are all the same
         size as "Climbing Styles". -->
    <style name="ItemSectionSubTitle" parent="SectionItemLabel">
        <item name="android:textSize">18sp</item>
    </style>

    <!-- The straight line distance from the user to a POI and its compass point, each after its
         icon, with what it is on a long press, in the info dialogs and the lists of climbing POIs,
         see DialogueUtils.setDistance. -->
    <style name="DistanceFromUser">
        <item name="android:drawableStart">@drawable/ic_distance_from_user</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:tooltipText">@string/distance_from_user</item>
    </style>

    <style name="DirectionFromUser" parent="DistanceFromUser">
        <item name="android:drawableStart">@drawable/ic_direction_from_user</item>
        <item name="android:tooltipText">@string/direction_from_user</item>
    </style>

    <style name="SectionItemLabel">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Colour-coded grade value shown in the info dialogs and the grade conversion popup. -->
    <style name="GradeLabel" parent="SectionItemLabel">
        <item name="android:layout_width">70dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingBottom">1dp</item>
        <item name="android:textColor">@android:color/black</item>
    </style>

    <!-- Shared by check boxes and plain labels, so both look the same in the log book editor. -->
    <style name="LogBookEditorLabel" parent="SectionItemLabel">
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="TextContainer">
        <item name="android:layout_margin">2dp</item>
    </style>

    <style name="ItemSectionContainer">
        <item name="android:background">?android:colorBackground</item>
        <item name="android:layout_margin">2dp</item>
    </style>

    <style name="ItemSubSectionContainer" parent="ItemSectionContainer">
        <item name="android:layout_margin">10dp</item>
    </style>

    <style name="ItemContainer">
        <item name="android:background">@color/itemContainerBackground</item>
    </style>

    <!-- ItemContainer of the screens editing OpenStreetMap data. -->
    <style name="EditItemContainer">
        <item name="android:background">@drawable/bg_edit_mode</item>
    </style>

    <!-- Fullscreen dialogs follow the day/night theme, like the activities do. -->
    <style name="BaseFullscreenDialogTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="FullscreenDialogTheme" parent="BaseFullscreenDialogTheme" />

    <style name="TableHeaderContainer">
        <item name="android:background">?android:colorBackground</item>
    </style>

    <style name="TableTextContainer">
        <item name="android:textStyle">bold</item>
        <item name="android:layout_margin">0.5dp</item>
    </style>

    <!-- TUTORIAL STYLES -->
    <style name="TitleText">
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">25sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="DescriptionText">
        <item name="android:textAlignment">center</item>
        <item name="android:textSize">15sp</item>
        <item name="android:padding">8dp</item>
        <item name="autoSizeTextType">uniform</item>
        <item name="autoSizeMinTextSize">11sp</item>
        <item name="autoSizeMaxTextSize">15sp</item>
        <item name="autoSizeStepGranularity">1sp</item>
    </style>

    <style name="NoShadowFloatingActionButton" parent="Widget.Design.FloatingActionButton">
        <item name="elevation">0dp</item>
        <item name="pressedTranslationZ">0dp</item>
        <item name="hoveredFocusedTranslationZ">0dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:translationZ">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

</resources>
