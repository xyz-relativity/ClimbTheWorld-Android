<resources>

    <!-- Backdrop behind the item sections; shows through as the gaps between them. -->
    <color name="itemContainerBackground">#e0e0e0</color>

    <!-- The caution stripes behind the OpenStreetMap editors, see bg_edit_mode. -->
    <color name="editStripeLight">#ffd600</color>
    <color name="editStripeDark">#212121</color>

    <!-- Pill behind the map search field; must contrast with the theme's text colour. -->
    <color name="searchBarBackground">#f2f2f2</color>

    <!-- The fill of the bookmark star of what is bookmarked, tinting the white of ic_bookmark
         with multiply, as the grade colours tint the pins, so its outline stays black. -->
    <color name="bookmarked">#ffc107</color>

</resources>
