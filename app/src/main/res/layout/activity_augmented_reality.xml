<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#b0bbbb"
    tools:context=".activities.AugmentedRealityActivity"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/arContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.65">

        <androidx.camera.view.PreviewView
            android:id="@+id/cameraTexture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#b0bbbb"
            app:scaleType="fillCenter"
            app:implementationMode="compatible"

            android:layout_alignParentTop="true"
            />

        <!-- What ARCore's camera sees, with the rock as its depth sees it, in place of the preview
             above on the phones ARCore runs on, in the non-FOSS build; see ArViewTracking. Before
             the scene, which is drawn over it. -->
        <android.opengl.GLSurfaceView
            android:id="@+id/arSurfaceView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/cameraTextError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textAlignment="center"
            android:layout_centerInParent="true"
            android:text="@string/no_camera_permissions"
            />

        <RelativeLayout
            android:id="@+id/arViewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.climbtheworld.app.augmentedreality.TerrainWireframeView
                android:id="@+id/terrainWireframe"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="invisible" />

            <View
                android:id="@+id/horizon"
                android:layout_width="match_parent"
                android:layout_height="3dip"
                android:layout_centerInParent="true"
                android:background="#a0ffffff" />

            <com.climbtheworld.app.augmentedreality.ClimbingHullView
                android:id="@+id/climbingHulls"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <com.climbtheworld.app.augmentedreality.RouteLineView
                android:id="@+id/routeLines"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </RelativeLayout>

        <!-- ARCore's aiming tools, as the A.R. placement in the node editor has them, while ARCore
             has the camera. -->
        <FrameLayout
            android:id="@+id/arCoreControls"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <!-- Between the buttons at the top. -->
            <TextView
                android:id="@+id/arStatusHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginStart="70dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="70dp"
                android:background="#99000000"
                android:gravity="center"
                android:padding="8dp"
                android:textColor="@android:color/white"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/arCrosshair"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:visibility="gone"
                app:srcCompat="@drawable/ic_ar_crosshair" />

            <!-- Below the crosshair. -->
            <TextView
                android:id="@+id/arCursorDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="44dp"
                android:shadowColor="@android:color/black"
                android:shadowRadius="4"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Align and Sight, down the right, below the settings button. -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/arAlignButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dip"
                        android:background="?android:selectableItemBackground"
                        android:contentDescription="@string/ar_placement_align"
                        android:enabled="false"
                        app:srcCompat="@drawable/ic_ar_align" />

                    <!-- How many mapped routes the A.R. is aligned on. -->
                    <TextView
                        android:id="@+id/arAlignedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/shape_count_badge"
                        android:gravity="center"
                        android:minWidth="20dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                </FrameLayout>

                <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/arSightButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dip"
                    android:background="?android:selectableItemBackground"
                    android:contentDescription="@string/ar_placement_sight"
                    android:enabled="false"
                    app:srcCompat="@drawable/ic_ar_sight" />

            </LinearLayout>

        </FrameLayout>

        <RelativeLayout
            android:id="@+id/compassLayout"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:adjustViewBounds="true"
            android:rotationX="40"
            style="?android:imageButtonStyle"
            android:background="?android:selectableItemBackground"
            >

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:alpha="0.5"
                android:src="@drawable/shape_background_circle" />

            <include
                android:id="@+id/compassBazel"
                layout="@layout/layout_compass_bazel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:padding="30dp"
                android:src="@drawable/ic_my_location" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/horizonModeButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:selectableItemBackground"
                android:onClick="onClick"
                android:contentDescription="@string/ar_horizon"
                android:cropToPadding="true"
                android:scaleType="fitXY"
                android:layout_margin="5dip"
                app:srcCompat="@drawable/ic_horizon_terrain" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/filterButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:selectableItemBackground"
                android:onClick="onClick"
                android:contentDescription="@string/hint_filter"
                android:cropToPadding="true"
                android:scaleType="fitXY"
                android:layout_margin="5dip"
                app:srcCompat="@drawable/ic_filter" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/arSettingsButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:background="?android:selectableItemBackground"
            android:onClick="onClick"
            android:contentDescription="@string/hint_ar_settings"
            android:cropToPadding="true"
            android:scaleType="fitXY"
            android:layout_margin="5dip"
            app:srcCompat="@drawable/ic_menu" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/mapViewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.35">

        <org.maplibre.android.maps.MapView
            android:id="@+id/openMapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true">

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/mapLayerToggleButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:selectableItemBackground"
                android:onClick="onClick"
                android:contentDescription="@string/hint_layer"
                android:cropToPadding="true"
                android:scaleType="fitXY"
                android:layout_margin="5dip"
                app:srcCompat="@drawable/ic_map_layer" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/toolsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:selectableItemBackground"
                android:onClick="onClick"
                android:contentDescription="@string/hint_download"
                android:cropToPadding="true"
                android:scaleType="fitXY"
                android:layout_margin="5dip"
                app:srcCompat="@drawable/ic_data_manager" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true">

            <include layout="@layout/map_compass_button" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/mapCenterOnGpsButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?android:selectableItemBackground"
                android:contentDescription="@string/hint_center_gps"
                android:layout_margin="5dip"
                app:srcCompat="@drawable/ic_center_map" />
        </LinearLayout>

        <include layout="@layout/map_zoom_controls" />

    </RelativeLayout>
</LinearLayout>
