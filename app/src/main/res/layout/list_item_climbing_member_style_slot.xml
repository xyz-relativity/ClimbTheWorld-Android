<?xml version="1.0" encoding="utf-8"?>
<!-- A climbing style of a crag card's strip, or the unknown style: the histogram of its routes'
     grades on its block, see NodeDialogBuilder.addStyleStrip. The slots share the strip's
     width. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:gravity="center_horizontal"
    android:importantForAccessibility="noHideDescendants"
    android:orientation="vertical">

    <com.climbtheworld.app.utils.views.GradeHistogramView
        android:id="@+id/memberSlotHistogram"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginHorizontal="1dp" />

    <ImageView
        android:id="@+id/memberSlotIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:scaleType="fitCenter" />
</LinearLayout>
