<?xml version="1.0" encoding="utf-8"?>
<!-- The A.R. align dialog: the quick filter over the routes, side by side as they stand along the
     wall, grouped by crag, see list_item_alignment_group, left to right whatever the language, as
     the wall is. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include layout="@layout/layout_filter" />

    <HorizontalScrollView
        android:id="@+id/scrollAlignRoutes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        android:scrollbars="horizontal">

        <LinearLayout
            android:id="@+id/listAlignRoutes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/textNoMatchingRoutes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="@string/no_match"
        android:visibility="gone" />
</LinearLayout>
