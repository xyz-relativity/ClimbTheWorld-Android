<?xml version="1.0" encoding="utf-8"?>
<!-- The new parent and find rows go below the list, from the code, styled like the list's rows.
     The list takes what height is left, so a long one scrolls with the rows still showing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <ListView
        android:id="@+id/listParents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include
        layout="@layout/layout_filter"
        android:visibility="gone" />
</LinearLayout>
