<?xml version="1.0" encoding="utf-8"?>
<!-- What is left of the editors' general tags, the description and the website, after the
     crags or areas the element is in, see GeneralTags: the name is right after the type, see
     fragment_edit_name, and a node's position in its own section, see fragment_edit_location. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/ItemSectionContainer"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/deviceSettings"
            style="@style/ItemSectionTitles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/general_information" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@android:color/darker_gray" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/ItemSubSectionContainer"
        android:orientation="vertical">

        <TextView
            android:id="@+id/description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ItemSectionSubTitle"
            android:labelFor="@id/editDescription"
            android:text="@string/description_num_characters"
            android:textAllCaps="false" />

        <EditText
            android:id="@+id/editDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/description_num_characters"
            android:ems="10"
            android:maxLength="255"
            android:inputType="textAutoCorrect|textMultiLine" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        style="@style/ItemSubSectionContainer"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textWebsite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="@style/ItemSectionSubTitle"
            android:labelFor="@id/editWebsite"
            android:text="@string/website"
            android:textAllCaps="false" />

        <EditText
            android:id="@+id/editWebsite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/website"
            android:ems="10"
            android:inputType="textUri"
            android:text="" />
    </LinearLayout>

</LinearLayout>