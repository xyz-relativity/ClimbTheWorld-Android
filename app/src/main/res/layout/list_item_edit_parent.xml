<?xml version="1.0" encoding="utf-8"?>
<!-- A crag or area the edited element is in, in the editors, see ParentMembership: its pin, its
     name over how many elements it holds, and the button taking the element out of it. The pin
     and the button are the size of the type's pin in the editor, which ParentMembership gives
     them, see list_item_switch_description_content's imageIcon. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/ItemSubSectionContainer"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Shown once the pin is drawn, with its route count. -->
    <ImageView
        android:id="@+id/imageParentIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:cropToPadding="true"
        android:importantForAccessibility="no"
        android:paddingEnd="2dp"
        android:scaleType="centerInside"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textParentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            android:id="@+id/textParentElements"
            style="@style/SectionItemLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- The delete icon of the download manager's country list. -->
    <ImageView
        android:id="@+id/buttonRemoveFromParent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="5dp"
        android:adjustViewBounds="true"
        android:background="?android:selectableItemBackground"
        android:clickable="true"
        android:contentDescription="@string/remove_from_crag"
        android:cropToPadding="true"
        android:focusable="true"
        android:scaleType="fitXY"
        android:src="@drawable/ic_delete" />
</LinearLayout>
