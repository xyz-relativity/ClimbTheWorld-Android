<?xml version="1.0" encoding="utf-8"?><!-- Shared by every map container; positioned against a RelativeLayout parent. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mapZoomControls"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_alignParentBottom="true"
    android:layout_centerHorizontal="true"
    android:layout_marginBottom="16dp"
    android:orientation="horizontal">

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/mapZoomOutButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dip"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/hint_zoom_out"
        android:cropToPadding="true"
        android:scaleType="fitXY"
        app:fabCustomSize="38dp"
        app:maxImageSize="12dp"
        app:srcCompat="@drawable/ic_zoom_out" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/mapZoomInButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="5dip"
        android:background="?android:selectableItemBackground"
        android:contentDescription="@string/hint_zoom_in"
        android:cropToPadding="true"
        android:scaleType="fitXY"
        app:fabCustomSize="38dp"
        app:maxImageSize="12dp"
        app:srcCompat="@drawable/ic_zoom_in" />

</LinearLayout>
