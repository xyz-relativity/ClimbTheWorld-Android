<?xml version="1.0" encoding="utf-8"?>
<!-- A row of the lists of climbing POIs, see ClimbingPoiRow: the pin, the name with what the POI
     is part of under it, the straight line distance over the compass point, each after its
     icon, and the button centering the map on the POI, the distance part as in the info dialogs'
     fragment_info_geoloc, under the same ids and styles. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/climbingPoiIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:cropToPadding="true"
        android:importantForAccessibility="no"
        android:paddingEnd="2dp"
        android:scaleType="centerInside" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/climbingPoiName"
            style="@style/SectionItemLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/climbingPoiParent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- On two lines, centred as the button beside them, the icons in a column and the values
         lined up on the right. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/editDistance"
            style="@style/DistanceFromUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:maxLines="1" />

        <TextView
            android:id="@+id/editBearings"
            style="@style/DirectionFromUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:maxLines="1" />
    </LinearLayout>

    <ImageView
        android:id="@+id/showOnMapButton"
        style="?android:imageButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:background="?android:selectableItemBackground"
        android:clickable="true"
        android:contentDescription="@string/center_map_on_point"
        android:focusable="true"
        android:padding="8dp"
        android:src="@drawable/ic_tap_marker"
        android:tooltipText="@string/center_map_on_point" />
</LinearLayout>
