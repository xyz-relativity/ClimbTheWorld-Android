<?xml version="1.0" encoding="utf-8"?>
<!-- The log book and the bookmarks, each on its own page, see fragment_log_book_page. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    style="@style/ItemContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.climbtheworld.app.activities.LogBookActivity">

    <androidx.viewpager.widget.ViewPager
        android:id="@+id/logBookPager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/logBookNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/windowBackground"
        app:itemIconTint="@color/button_tab_text_selector"
        app:itemTextColor="@color/button_tab_text_selector"
        app:menu="@menu/log_book_navigation" />
</LinearLayout>
