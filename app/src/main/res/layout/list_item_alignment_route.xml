<?xml version="1.0" encoding="utf-8"?>
<!-- A route of the A.R. align dialog: its card as the crag dialog and the relation editor show
     their members, see MemberIconCard, with under it the straight line distance from the user,
     as the lists of climbing POIs show it, and a button to delete the alignment on the route,
     shown once it is aligned on, as it is then all outlined, see bg_align_route_aligned. A
     route suggested is outlined in its own colour, see bg_align_route_suggested, and marked on
     the bar under the strip, see SuggestionBar; a tap on the card aligns on it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="2dp">

    <include
        android:id="@+id/alignRouteCard"
        layout="@layout/list_item_climbing_member_icon" />

    <TextView
        android:id="@+id/alignRouteDistance"
        style="@style/DistanceFromUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1" />

    <!-- The download manager's country list's delete icon, smaller, 26dp, so it does not take
         much more room than the distance. -->
    <ImageView
        android:id="@+id/buttonDeleteAlignment"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?android:selectableItemBackground"
        android:clickable="true"
        android:contentDescription="@string/ar_placement_align_delete"
        android:focusable="true"
        android:padding="3dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_delete"
        android:tooltipText="@string/ar_placement_align_delete" />
</LinearLayout>
