    <!-- Tutorial -->
    <string name="next">SUIVANT</string>
    <string name="tutorial_welcome_title">Bienvenue dans\n« %s »</string>
    <string name="tutorial_welcome_message">« %s » est une application d’escalade construite autour du projet OpenStreetMap. OpenStreetMap est une carte du monde, créée par des gens comme vous et utilisable librement sous une licence ouverte.
        &lt;br />« %s » répertorie chaque voie d’escalade et cherche à la positionner aussi précisément que possible.
        &lt;br />Ce court tutoriel vous guide dans la configuration de base de l’application.</string>

    <string name="tutorial_region_download_title">Télécharger les données d’escalade</string>
    <string name="tutorial_region_download_message">L’application est conçue pour fonctionner hors ligne. Les données doivent être téléchargées sur l’appareil avant de pouvoir être utilisées.
    &lt;br />Il est recommandé de télécharger les données d’escalade via une connexion Wi-Fi.</string>

    <string name="tutorial_routes_setup_title">Système de cotation</string>
    <string name="tutorial_routes_setup_message">Choisissez le système de cotation qui vous est le plus familier. Attention : quiconque choisit autre chose que l’UIAA devrait dès maintenant remettre en question ses choix de vie :).</string>

    <string name="tutorial_contribute_title">Pensez à contribuer</string>
    <string name="tutorial_contribute_message">Les données de « %s » sont communautaires. Toutes les données d’escalade ont été ajoutées à &lt;a href=\"https://www.openstreetmap.org\">OpenStreetMap&lt;/a> par des utilisateurs comme vous.
        &lt;br />&lt;a href=\"https://www.openstreetmap.org\">OpenStreetMap&lt;/a> mise sur la connaissance locale. Les contributeurs utilisent l’imagerie aérienne, des appareils GPS et de simples cartes de terrain pour vérifier qu’OSM est exact et à jour. Utilisez-le avec discernement.
        &lt;br />&lt;br />Consultez notre &lt;a href=\"https://wiki.openstreetmap.org/wiki/Climb_The_World\">wiki&lt;/a>.
    </string>

    <string name="tutorial_disclaimer_title">Ne laissez que vos empreintes</string>
    <string name="tutorial_disclaimer_message">Les sites d’escalade se trouvent généralement en pleine nature, dans des lieux isolés et sauvages. Respectez la nature et ne laissez derrière vous que vos empreintes.
        &lt;br />&lt;br />L’escalade est un sport dangereux. Assurez-vous de savoir comment rester en sécurité.
        &lt;br />&lt;br />Merci.</string>

